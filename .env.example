# Configuración general. Para el piloto usá .env.demo.example en otro servicio.
PROVEEDOR=gemini
GOOGLE_API_KEY=
MODELO_GEMINI=gemini-2.5-pro
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODO=test
SQLITE_RUTA=datos/conversaciones.db
POSTGRES_DSN=
PROMPT_SISTEMA=prompts/plantillas/general.md
# Vacío conserva respuestas solo de texto. Debe apuntar a un JSON dentro de catalogos/.
PROMOCIONES_RUTA=
# Catálogo de productos con fotos y cotizador. Vacío: el bot no ofrece productos.
CATALOGO_RUTA=
# El portal como fuente única de productos, servicios, promociones y fotos.
# Al habilitarlo, dejá PROMOCIONES_RUTA y CATALOGO_RUTA vacíos.
# PORTAL_CLAVE_BOT se crea con scripts/portal_admin.py
# clave-bot y es un secreto: solo en el .env real, nunca acá.
PORTAL_URL=
PORTAL_CLAVE_BOT=
# Identidad esperada: una clave de otro negocio debe rechazarse.
PORTAL_NEGOCIO_ID=
# Obligatorio si el negocio publicó líneas/sucursales; código de esa línea.
PORTAL_LINEA=
MAX_TOKENS=4096
MEMORIA_MENSAJES=20
CACHE=true
TELEGRAM_TOKEN=
CHATWOOT_URL=
CHATWOOT_TOKEN=
CHATWOOT_CUENTA_ID=1
# Vacío acepta las bandejas de esa cuenta. Cada cliente nuevo debe fijar la suya.
CHATWOOT_BANDEJA_ID=
CHATWOOT_WEBHOOK_TOKEN=
CHATWOOT_ETIQUETA_HUMANO=humano
BUFFER_SEGUNDOS=8
RITMO_HUMANO=true
PUERTO=8000

# Ajuste opcional del webhook de WhatsApp; las demás variables están en README.md.
# Mínimo desde el último mensaje de cada ráfaga hasta la primera respuesta.
# Incluye el buffer y el tiempo de la IA. Si la IA tarda más, no suma otra pausa.
# 0 desactiva este mínimo; no cambia BUFFER_SEGUNDOS.
RESPUESTA_MINIMA_SEGUNDOS=15
# Agenda opcional: vacía conserva el comportamiento de siempre.
# La configuración de prueba no activa ningún calendario por sí sola.
AGENDA_REGLAS_RUTA=
AGENDA_DSN=
AGENDA_GOOGLE_CLIENTE_ID=
AGENDA_GOOGLE_SECRETO=
AGENDA_GOOGLE_REFRESH_TOKEN=
AGENDA_PLANTILLA_WHATSAPP=
AGENDA_PLANTILLA_IDIOMA=es
