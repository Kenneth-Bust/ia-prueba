# Copiá a .env.agenda.local. El webhook no lo carga automáticamente.
# Credenciales OAuth Desktop: scripts/conectar_google_agenda.py
AGENDA_GOOGLE_CLIENTE_ID=
AGENDA_GOOGLE_SECRETO=
AGENDA_GOOGLE_REFRESH_TOKEN=
AGENDA_REGLAS_RUTA=agendas/smarth_house.json
# Producción: PostgreSQL propio con rol limitado y host Docker interno.
# Pruebas locales: datos/agenda-pruebas.db con MODO=test.
AGENDA_DSN=
CHATWOOT_CUENTA_ID=1
CHATWOOT_BANDEJA_ID=1
# Debe coincidir exactamente con una plantilla UTILITY aprobada de 5 variables.
AGENDA_PLANTILLA_WHATSAPP=
AGENDA_PLANTILLA_IDIOMA=es
