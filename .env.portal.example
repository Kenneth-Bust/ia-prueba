# Portal de catálogos (docs/portal.md). Copialo como .env.portal.local,
# que Git y Docker ignoran. En Coolify, estas variables van en la aplicación
# del portal, nunca en la de un bot.

# Base propia del portal. Desde un contenedor, el host es el nombre interno
# del PostgreSQL, no la IP pública del servidor.
PORTAL_DSN=

# Carpeta de las fotos. En el servidor, un volumen persistente.
PORTAL_ARCHIVOS=datos/portal

# true en el servidor (HTTPS). false solo en tu computadora.
PORTAL_COOKIE_SEGURA=true

# En el servidor: 0.0.0.0 y el dominio del portal. En tu computadora quedan
# vacíos y se usa 127.0.0.1:8010.
PORTAL_HOST=
PORTAL_HOSTS=
PUERTO=8010

# Proxies a los que se les cree X-Forwarded-For (la red del proxy de Coolify).
PORTAL_PROXIES=127.0.0.1
