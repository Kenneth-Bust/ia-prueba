# Plantilla del NUEVO servicio bot-demo. No reemplaza el .env de tu agencia.
# Guardá los valores reales en .env.demo.local o en las variables de Coolify.
PROVEEDOR=gemini
GOOGLE_API_KEY=
# Elegí un modelo habilitado en tu proyecto de Google antes de desplegar.
MODELO_GEMINI=
MODO=produccion
POSTGRES_DSN=
PROMPT_SISTEMA=prompts/demo.md
MAX_TOKENS=512
MEMORIA_MENSAJES=20
BUFFER_SEGUNDOS=1
RITMO_HUMANO=false
CACHE=true
PUERTO=8000
CHATWOOT_URL=https://appchatwoot.automaticnic.online
CHATWOOT_CUENTA_ID=
CHATWOOT_BANDEJA_ID=
CHATWOOT_TOKEN=
CHATWOOT_WEBHOOK_TOKEN=
CHATWOOT_ETIQUETA_HUMANO=humano
